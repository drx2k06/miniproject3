# QuantPulse Environment Variables Template
# Copy this file to .env and configure as needed.

# Binance Public Vision REST Endpoint (Free, no API key required)
BINANCE_BASE=https://data-api.binance.vision

# Target Cryptocurrency Pair
SYMBOL=BTCUSDT

# Default Bar Aggregation Interval (seconds)
BAR_SECONDS=1

# Supervised Horizon & Risk Parameters
PREDICT_AHEAD=10
TAIL_QUANTILE=0.25
TEST_SPLIT=0.30

# Simulated Exchange Frictions
TAKER_FEE=0.00075
SLIPPAGE=0.00050

# Paper Trading Capital (USDT)
PAPER_CASH=10000.0
RISK_PCT=10.0
